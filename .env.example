# PostgreSQL, using your development branch or database
# Use sslmode=verify-full on the pooled URL for hosted PostgreSQL.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# UploadThing v7 token and the ID of the app that owns the uploads
UPLOADTHING_TOKEN=
NEXT_PUBLIC_UPLOADTHING_APP_ID=

# Stream Chat app key and server secret
NEXT_PUBLIC_STREAM_KEY=
STREAM_SECRET=

# Vercel Cron bearer secret (generate a separate value for each environment)
CRON_SECRET=
